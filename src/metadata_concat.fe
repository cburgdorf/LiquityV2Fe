use core::ptr::MemSpan
use std::abi::{Bytes, DynString}
use super::bytes_builder::BytesBuilder

pub fn fragment(_ value: String<31>) -> Bytes {
    let len = value.len() as u256
    var out = BytesBuilder::zeroed(32)
    out.write_word(at: 0, value: (value as u256) << ((32 - len) * 8))
    out.truncate(len)
    out.into_bytes()
}

#[inline(never)]
pub fn text(_ value: Bytes) -> DynString { DynString::from_payload(source: value.span()) }

#[inline(never)]
pub fn cat(_ left: MemSpan, _ right: MemSpan) -> DynString {
    var out = BytesBuilder::with_capacity((left.len() + right.len()) as u256)
    out.append(left)
    out.append(right)
    out.into_string()
}
