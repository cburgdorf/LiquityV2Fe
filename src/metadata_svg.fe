use std::abi::DynString
use super::metadata_string::{cat, fragment, text, decimal}
#[inline(never)]
pub fn el_2(_ tag: DynString, _ props: DynString) -> DynString { cat((cat((cat((cat((text(fragment("<"))).span(), (tag).span())).span(), (text(fragment(" "))).span())).span(), (props).span())).span(), (text(fragment("/>"))).span()) }
#[inline(never)]
pub fn el_3(_ tag: DynString, _ props: DynString, _ children: DynString) -> DynString { cat((cat((cat((cat((cat((cat((cat((cat((text(fragment("<"))).span(), (tag).span())).span(), (text(fragment(" "))).span())).span(), (props).span())).span(), (text(fragment(">"))).span())).span(), (children).span())).span(), (text(fragment("</"))).span())).span(), (tag).span())).span(), (text(fragment(">"))).span()) }
#[inline(never)]
pub fn prop_3(_ key: DynString, _ value: DynString, _ last: bool) -> DynString { cat((cat((cat((key).span(), (text(fragment("=\""))).span())).span(), (value).span())).span(), (if last { text(fragment("\"")) } else { text(fragment("\" ")) }).span()) }
#[inline(never)]
pub fn prop_2(_ key: DynString, _ value: DynString) -> DynString { prop_3(key, value, false) }
#[inline(never)]
pub fn g_2(_ props: DynString, _ children: DynString) -> DynString { el_3(text(fragment("g")), props, children) }
#[inline(never)]
pub fn text_2(_ props: DynString, _ children: DynString) -> DynString { el_3(text(fragment("text")), props, children) }
#[inline(never)]
pub fn filter_2(_ props: DynString, _ children: DynString) -> DynString { el_3(text(fragment("filter")), props, children) }
#[inline(never)]
pub fn radialGradient_2(_ props: DynString, _ children: DynString) -> DynString { el_3(text(fragment("radialGradient")), props, children) }
#[inline(never)]
pub fn linearGradient_2(_ props: DynString, _ children: DynString) -> DynString { el_3(text(fragment("linearGradient")), props, children) }
#[inline(never)]
pub fn line_1(_ props: DynString) -> DynString { el_2(text(fragment("line")), props) }
#[inline(never)]
pub fn line_2(_ props: DynString, _ children: DynString) -> DynString { el_3(text(fragment("line")), props, children) }
#[inline(never)]
pub fn ellipse_1(_ props: DynString) -> DynString { el_2(text(fragment("ellipse")), props) }
#[inline(never)]
pub fn ellipse_2(_ props: DynString, _ children: DynString) -> DynString { el_3(text(fragment("ellipse")), props, children) }
#[inline(never)]
pub fn polygon_1(_ props: DynString) -> DynString { el_2(text(fragment("polygon")), props) }
#[inline(never)]
pub fn polygon_2(_ props: DynString, _ children: DynString) -> DynString { el_3(text(fragment("polygon")), props, children) }
#[inline(never)]
pub fn polyline_1(_ props: DynString) -> DynString { el_2(text(fragment("polyline")), props) }
#[inline(never)]
pub fn polyline_2(_ props: DynString, _ children: DynString) -> DynString { el_3(text(fragment("polyline")), props, children) }
#[inline(never)]
pub fn rect_1(_ props: DynString) -> DynString { el_2(text(fragment("rect")), props) }
#[inline(never)]
pub fn rect_2(_ props: DynString, _ children: DynString) -> DynString { el_3(text(fragment("rect")), props, children) }
#[inline(never)]
pub fn circle_1(_ props: DynString) -> DynString { el_2(text(fragment("circle")), props) }
#[inline(never)]
pub fn circle_2(_ props: DynString, _ children: DynString) -> DynString { el_3(text(fragment("circle")), props, children) }
#[inline(never)]
pub fn animateTransform_1(_ props: DynString) -> DynString { el_2(text(fragment("animateTransform")), props) }
#[inline(never)]
pub fn animate_1(_ props: DynString) -> DynString { el_2(text(fragment("animate")), props) }
#[inline(never)]
pub fn svg_2(_ props: DynString, _ children: DynString) -> DynString { el_3(text(fragment("svg")), cat((cat((text(fragment("xmlns=\"http://www.w3.org/2000/s"))).span(), (text(fragment("vg\" "))).span())).span(), (props).span()), children) }
#[inline(never)]
pub fn style_2(_ title: DynString, _ props: DynString) -> DynString { el_2(text(fragment("style")), cat((cat((cat((text(fragment("."))).span(), (title).span())).span(), (text(fragment(" "))).span())).span(), (props).span())) }
#[inline(never)]
pub fn path_1(_ d: DynString) -> DynString { el_2(text(fragment("path")), prop_3(text(fragment("d")), d, true)) }
#[inline(never)]
pub fn path_2(_ d: DynString, _ props: DynString) -> DynString { el_2(text(fragment("path")), cat((prop_2(text(fragment("d")), d)).span(), (props).span())) }
#[inline(never)]
pub fn path_3(_ d: DynString, _ props: DynString, _ children: DynString) -> DynString { el_3(text(fragment("path")), cat((prop_2(text(fragment("d")), d)).span(), (props).span()), children) }
#[inline(never)]
pub fn circle_3(_ cx: DynString, _ cy: DynString, _ r: DynString) -> DynString { el_2(text(fragment("circle")), cat((cat((prop_2(text(fragment("cx")), cx)).span(), (prop_2(text(fragment("cy")), cy)).span())).span(), (prop_3(text(fragment("r")), r, true)).span())) }
#[inline(never)]
pub fn circle_4(_ cx: DynString, _ cy: DynString, _ r: DynString, _ children: DynString) -> DynString { el_3(text(fragment("circle")), cat((cat((prop_2(text(fragment("cx")), cx)).span(), (prop_2(text(fragment("cy")), cy)).span())).span(), (prop_3(text(fragment("r")), r, true)).span()), children) }
#[inline(never)]
pub fn circle_5(_ cx: DynString, _ cy: DynString, _ r: DynString, _ props: DynString, _ children: DynString) -> DynString { el_3(text(fragment("circle")), cat((cat((cat((prop_2(text(fragment("cx")), cx)).span(), (prop_2(text(fragment("cy")), cy)).span())).span(), (prop_3(text(fragment("r")), r, false)).span())).span(), (props).span()), children) }
#[inline(never)]
pub fn cdata_1(_ content: DynString) -> DynString { cat((cat((text(fragment("<![CDATA["))).span(), (content).span())).span(), (text(fragment("]]>"))).span()) }
#[inline(never)]
pub fn gradientStop_3(_ offset: u256, _ color: DynString, _ props: DynString) -> DynString { el_3(text(fragment("stop")), cat((cat((cat((cat((prop_2(text(fragment("stop-color")), color)).span(), (text(fragment(" "))).span())).span(), (prop_2(text(fragment("offset")), cat((decimal(offset)).span(), (text(fragment("%"))).span()))).span())).span(), (text(fragment(" "))).span())).span(), (props).span()), DynString::empty()) }
