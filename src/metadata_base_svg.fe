use std::abi::{DynString, Bytes4}
use std::evm::{Address, Call}
use std::evm::crypto::keccak256
use core::text::decimal
use super::metadata_string::{cat, fragment, text, checksum, slice, locale}
use super::metadata_svg as svg
use super::metadata_literals as lit
use super::fixed_asset_reader::FixedAssetReaderMsg
pub const GEIST: String<31> = "style=\"font-family: Geist\" "
pub const DARK_BLUE: String<7> = "#121B44"
pub const STOIC_WHITE: String<7> = "#DEE4FB"
#[inline(never)]
pub fn svg_props() -> DynString {
    let out = cat(svg::prop_2(text(fragment("width")), text(fragment("300"))).span(), svg::prop_2(text(fragment("height")), text(fragment("484"))).span())
    let out = cat(out.span(), svg::prop_2(text(fragment("viewBox")), text(fragment("0 0 300 484"))).span())
    cat(out.span(), svg::prop_2(text(fragment("style")), text(fragment("background:none"))).span())
}
#[inline(never)]
fn asset(_ reader: Address, _ name: DynString) -> DynString uses (call: Call) {
    reader.static(FixedAssetReaderMsg::ReadAsset { sig: Bytes4 { val: keccak256(name.span()) >> 224 } })
}
#[inline(never)]
pub fn leverage_logo() -> DynString { lit::leverage_logo() }
#[inline(never)]
pub fn static_text_els() -> DynString { lit::static_text() }
#[inline(never)]
pub fn bold_logo(_ reader: Address) -> DynString uses (call: Call) {
    cat(cat(lit::bold_logo_open().span(), asset(reader, text(fragment("BOLD"))).span()).span(), lit::image_close().span())
}
#[inline(never)]
pub fn coll_logo(_ name: DynString, _ reader: Address) -> DynString uses (call: Call) {
    cat(cat(lit::coll_logo_open().span(), asset(reader, name).span()).span(), lit::image_close().span())
}
#[inline(never)]
pub fn base_elements(_ reader: Address) -> DynString uses (call: Call) {
    let font = asset(reader, text(fragment("geist")))
    let out = cat(lit::background().span(), lit::font_open().span())
    let out = cat(out.span(), font.span())
    let out = cat(out.span(), lit::font_close().span())
    let out = cat(out.span(), leverage_logo().span())
    let out = cat(out.span(), bold_logo(reader).span())
    cat(out.span(), static_text_els().span())
}
#[inline(never)]
pub fn formatted_dynamic_el(_ value: DynString, _ x: u256, _ y: u256) -> DynString {
    let out = cat(fragment(GEIST).span(), svg::prop_2(text(fragment("text-anchor")), text(fragment("end"))).span())
    let out = cat(out.span(), svg::prop_2(text(fragment("x")), decimal(x)).span())
    let out = cat(out.span(), svg::prop_2(text(fragment("y")), decimal(y)).span())
    let out = cat(out.span(), svg::prop_2(text(fragment("font-size")), text(fragment("20"))).span())
    let out = cat(out.span(), svg::prop_2(text(fragment("fill")), text(fragment("white"))).span())
    svg::text_2(out, value)
}
#[inline(never)]
pub fn formatted_id_el(_ id: DynString) -> DynString {
    cat(cat(lit::id_open().span(), id.span()).span(), fragment("</text>").span())
}
#[inline(never)]
pub fn formatted_address_el(_ address: Address) -> DynString {
    let full = checksum(address)
    let short = cat(cat(slice(full, 0, 6).span(), fragment("...").span()).span(), slice(full, 38, 42).span())
    cat(cat(lit::owner_open().span(), short.span()).span(), fragment("</text>").span())
}
#[inline(never)]
pub fn status_el(_ status: DynString) -> DynString {
    cat(cat(lit::status_open().span(), status.span()).span(), fragment("</text>").span())
}
#[inline(never)]
pub fn dynamic_text_els(_ debt: u256, _ coll: u256, _ interest: u256) -> DynString {
    let out = formatted_dynamic_el(locale(coll, 18, 4), 256, 360)
    let out = cat(out.span(), formatted_dynamic_el(locale(debt, 18, 2), 256, 391).span())
    cat(out.span(), formatted_dynamic_el(locale(interest, 16, 2), 256, 422).span())
}
